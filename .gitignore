# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class

# Python package build metadata
*.egg-info/
build/
dist/

# Telemetry, ghost and binary replay files
*.blap
*.olap
*.ld
*.ldx
*.blapta
*.olapta
*.ghost

# Data directory
data/

# One-off analysis and experiment scripts
scratch/

# Temporary JSON outputs & report files
*.json
analysis_report.md
*.tmp
*.log

# Sanitized, vehicle-independent public track references
!track_references/
!track_references/*.json

# OS generated files
.DS_Store
Thumbs.db
