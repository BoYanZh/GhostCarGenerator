# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Python package build metadata
*.egg-info/
build/
dist/

# Telemetry, ghost and binary replay files
*.blap
*.olap
*.ld
*.ldx
*.blapta
*.olapta
*.ghost

# Private/local work directories
data/
tmp/
.work/

# One-off analysis and experiment scripts
scratch/

# Temporary JSON outputs & report files
*.json
analysis_report.md
*.tmp
*.log

# Versioned public track resources included in the Python package
!src/ghost_car/resources/
!src/ghost_car/resources/**/*.json
src/ghost_car/resources/**/*.gcsurface

# OS generated files
.DS_Store
Thumbs.db
